# Copie para .env.test. Valores padrão do Supabase local (`supabase start` / `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-key-do-supabase-status>
# Uso exclusivo dos testes de integração (criação de usuários de teste). Nunca usar em NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-do-supabase-status>

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
